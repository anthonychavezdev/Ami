# Secrets for `docker compose up` (copy to .env, which stays out of git).
# Long random values: openssl rand -hex 24
AMI_DB_PASSWORD=
AMI_TURN_SECRET=
# The public address phones reach this machine at, only if coturn cannot
# detect it on its own (no route to the internet from the container).
#AMI_PUBLIC_IP=
# Who may register: `docker compose exec server ami-server -new-invite` makes
# one-time codes while the server runs (the first one closes open
# registration). A standing code here works instead, or as well.
AMI_INVITE=
# The most one account may upload in total, in GB; 0 is no limit.
AMI_USER_STORAGE_GB=0
# Ports published on this machine (the dev shell reads AMI_PORT too).
#AMI_PORT=8080
#AMI_TURN_PORT=3478
